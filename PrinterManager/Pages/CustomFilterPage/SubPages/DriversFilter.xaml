<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PrinterManager.Pages.CustomFilterPage.SubPages.DriversFilter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:PrinterManager.Controls.Table"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PrinterManager.Pages.CustomFilterPage.SubPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="using:PrinterManager.Resources"
    xmlns:vm="using:PrinterManager.Pages.CustomFilterPage.Filters"
    d:DataContext="{d:DesignInstance Type=vm:PrinterFilterModel}"
    mc:Ignorable="d">

    <ctl:DataTable
        x:Name="PrintersTable"
        Grid.Column="2"
        ItemsSource="{x:Bind DriverFiltersList}">

        <ctl:TableColumn
            Width="468"
            Header="Driver Name"
            IsPrimary="True"
            Path="DriverName">
            <ctl:TableColumn.CellTemplate>
                <DataTemplate x:DataType="vm:DriversFilterModel">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            FontFamily="{x:Bind res:Icons.Driver.Font}"
                            FontSize="16"
                            Glyph="{x:Bind res:Icons.Driver.Glyph}" />

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{x:Bind DriverName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ctl:TableColumn.CellTemplate>
        </ctl:TableColumn>



        <ctl:TableColumn
            Width="152"
            Header="Environment"
            Path="Environment" />

        <ctl:TableColumn
            Width="151"
            Header="Driver Version"
            Path="DriverVersion" />

        <ctl:TableColumn
            Width="130"
            Header="Driver Isolation"
            Path="DriverIsolation" />

        <ctl:TableColumn
            Width="112"
            Header="Provider"
            Path="Provider" />

        <ctl:TableColumn
            Width="221"
            Header="Server Name"
            Path="ServerName" />

        <ctl:TableColumn
            Width="129"
            Header="Print Processor"
            Path="PrintProcessor" />

        <ctl:TableColumn
            Width="112"
            Header="Packaged"
            Path="Packaged" />

        <ctl:TableColumn
            Width="112"
            Header="Driver Date"
            Path="DriverDate" />

        <ctl:TableColumn
            Width="795"
            Header="Inf Path"
            Path="InfPath" />

        <ctl:TableColumn
            Width="112"
            Header="XPSDriver"
            Path="XPSDriver" />

        <ctl:TableColumn
            Width="861"
            Header="Config File Path"
            Path="ConfigFilePath" />

        <ctl:TableColumn
            Width="764"
            Header="Data File Path"
            Path="DataFilePath" />

        <ctl:TableColumn
            Width="141"
            Header="Default Datatype"
            Path="DefaultDatatype" />

        <ctl:TableColumn
            Width="814"
            Header="Driver File Path"
            Path="DriverFilePath" />

        <ctl:TableColumn
            Width="331"
            Header="Hardware I D"
            Path="HardwareID" />

        <ctl:TableColumn
            Width="121"
            Header="Help File Path"
            Path="HelpFilePath" />

        <ctl:TableColumn
            Width="151"
            Header="Language Monitor"
            Path="LanguageMonitor" />

        <ctl:TableColumn
            Width="119"
            Header="Manufacturer"
            Path="Manufacturer" />

        <ctl:TableColumn
            Width="112"
            Header="OEMURL"
            Path="OEMURL" />

        <ctl:TableColumn
            Width="112"
            Header="Shareable"
            Path="Shareable" />

        <ctl:TableColumn
            Width="173"
            Header="Type"
            Path="Type" />

    </ctl:DataTable>
</Page>
