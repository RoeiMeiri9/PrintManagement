<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="PrinterManager.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:PrinterManager.Pages.CustomFilterPage"
    xmlns:local="using:PrinterManager">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="/Resources/Themes.xaml" />
                <ResourceDictionary Source="/Resources/Fonts.xaml" />
                <ResourceDictionary>
                    <conv:StatusConverter x:Key="StatusToBrushConverter" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            <!--  Other app resources here  -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
