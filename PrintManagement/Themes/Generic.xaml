<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrlBdg="using:PrintManagement.Controls.BadgeControl">

    <Style TargetType="ctrlBdg:Badge">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctrlBdg:Badge">
                    <Border
                        Padding="{TemplateBinding BadgePadding}"
                        HorizontalAlignment="Left"
                        Background="{TemplateBinding BackgroundBrush}"
                        CornerRadius="12">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon
                                VerticalAlignment="Center"
                                FontFamily="{TemplateBinding GlyphFontFamily}"
                                FontSize="12"
                                Foreground="{TemplateBinding ForegroundBrush}"
                                Glyph="{TemplateBinding Glyph}"
                                Visibility="{TemplateBinding GlyphVisibility}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{TemplateBinding BadgeFontSize}"
                                FontWeight="{TemplateBinding BadgeFontWeight}"
                                Foreground="{TemplateBinding ForegroundBrush}"
                                Text="{TemplateBinding DisplayText}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>