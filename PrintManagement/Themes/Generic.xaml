<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PrintManagement.Controls">

    <Style TargetType="local:BoolBadge">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:BoolBadge">
                    <Border
                        Padding="8,3,12,3"
                        HorizontalAlignment="Left"
                        Background="{TemplateBinding BackgroundBrush}"
                        CornerRadius="12">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                VerticalAlignment="Center"
                                FontFamily="{TemplateBinding GlyphFontFamily}"
                                FontSize="12"
                                Foreground="{TemplateBinding ForegroundBrush}"
                                Glyph="{TemplateBinding Glyph}" />

                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{TemplateBinding ForegroundBrush}"
                                Text="{TemplateBinding DisplayText}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>