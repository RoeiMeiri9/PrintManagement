<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="PrintManagement.SubWindows.AdvancedFilterEditor.AdvancedFilterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PrintManagement.SubWindows.AdvancedFilterEditor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Add Filters"
    mc:Ignorable="d">
    <Grid x:Name="MainGrid" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar
            x:Name="titleBar"
            Grid.Row="0"
            Height="32"
            Background="{ThemeResource LayerFillColorAltBrush}"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">
            <TitleBar.Resources>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/Icons/IconGroup51.ico" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <TextBlock
                    x:Name="CustomAppTitle"
                    Grid.Column="0"
                    Margin="4,0,16,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind WindowTitle}" />
            </TitleBar.Content>
        </TitleBar>


        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ContentPresenter
                Grid.Row="0"
                Padding="24"
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Frame x:Name="ContentFrame" Grid.Row="0" />

                    <InfoBar
                        x:Name="ErrorBar"
                        Grid.Row="1"
                        Margin="0,16,0,0"
                        IsClosable="True"
                        IsOpen="False"
                        Severity="Error" />
                </Grid>
            </ContentPresenter>

            <Border Grid.Row="2" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Grid.Column="1"
                        Width="300"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="Backward"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            Content="Back" />
                        <Button
                            x:Name="Forward"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Content="Next"
                            Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
