<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PrintManagement.SubWindows.AdvancedFilterEditor.Pages.Filter_Stage2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:filter="using:PrintManagement.Models.Filter"
    xmlns:res="using:PrintManagement.Resources"
    xmlns:vm="using:PrintManagement.SubWindows.AdvancedFilterEditor">

    <Grid HorizontalAlignment="Stretch" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Choose what to show" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Only items that match every condition below will appear in the list."
                TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl x:Name="RulesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FilterRuleRow">
                            <Grid Margin="0,0,0,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="150" />
                                    <ColumnDefinition Width="Auto" MinWidth="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  Property  -->
                                <ComboBox
                                    Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind AvailableProperties}"
                                    PlaceholderText="Property"
                                    SelectedItem="{x:Bind Property, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="filter:FilterPropertyInfo">
                                            <TextBlock Text="{x:Bind DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!--  Condition  -->
                                <ComboBox
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{x:Bind HasProperty, Mode=OneWay}"
                                    ItemsSource="{x:Bind AvailableConditions, Mode=OneWay}"
                                    SelectedItem="{x:Bind SelectedCondition, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="filter:ConditionOption">
                                            <TextBlock Text="{x:Bind Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!--  Value: only one of these is visible at a time  -->
                                <Grid Grid.Column="2">
                                    <TextBox
                                        IsEnabled="{x:Bind HasProperty, Mode=OneWay}"
                                        PlaceholderText="Value"
                                        Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="{x:Bind IsText, Mode=OneWay}" />
                                    <NumberBox
                                        PlaceholderText="Number"
                                        SpinButtonPlacementMode="Hidden"
                                        Visibility="{x:Bind IsNumber, Mode=OneWay}"
                                        Value="{x:Bind NumberValue, Mode=TwoWay}" />
                                    <CalendarDatePicker
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Date="{x:Bind DateValue, Mode=TwoWay}"
                                        PlaceholderText="Pick a date"
                                        Visibility="{x:Bind IsDate, Mode=OneWay}" />
                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{x:Bind Choices, Mode=OneWay}"
                                        SelectedItem="{x:Bind Value, Mode=TwoWay}"
                                        Visibility="{x:Bind IsChoice, Mode=OneWay}" />
                                </Grid>

                                <Button
                                    Grid.Column="3"
                                    Click="RemoveRule_Click"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Remove condition">
                                    <FontIcon
                                        FontFamily="{x:Bind res:Icons.Delete.Font}"
                                        FontSize="14"
                                        Glyph="{x:Bind res:Icons.Delete.Glyph}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock
                    x:Name="EmptyHint"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="No conditions yet. Add one to get started."
                    Visibility="Collapsed" />
            </Grid>
        </ScrollViewer>

        <Button Grid.Row="2" Click="AddRule_Click">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontSize="14" Glyph="&#xE710;" />
                <TextBlock Text="Add condition" />
            </StackPanel>
        </Button>
    </Grid>
</Page>