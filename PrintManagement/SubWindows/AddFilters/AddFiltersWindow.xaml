<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="PrintManagement.SubWindows.AddFilters.AddFiltersWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PrintManagement.SubWindows.AddFilters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Add Filters"
    mc:Ignorable="d">

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ContentPresenter Grid.Row="0" Padding="24">
            <Frame x:Name="Page" />
        </ContentPresenter>

        <Border
            Grid.Row="1"
            Padding="24"
            Background="{ThemeResource ContentDialogBackground}"
            BorderBrush="{ThemeResource ContentDialogSeparatorBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="Forward"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    Content="Next"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    x:Name="Backward"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Content="Back" />
            </Grid>
        </Border>
    </Grid>
</Window>
