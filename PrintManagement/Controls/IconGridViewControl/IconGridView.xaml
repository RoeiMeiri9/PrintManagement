<UserControl
    x:Class="PrintManagement.Controls.IconGridViewControl.IconGridView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PrintManagement.Controls.IconGridViewControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="ItemTemplate" x:DataType="local:ItemModel">
            <ContentControl
                HorizontalAlignment="{x:Bind Alignment, Mode=OneWay}"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Stretch"
                CornerRadius="4"
                FocusVisualPrimaryBrush="{StaticResource AccentAAFillColorDefaultBrush}"
                GotFocus="Item_GotFocus"
                IsTabStop="True"
                PointerPressed="Item_PointerPressed"
                Tag="{x:Bind}"
                UseSystemFocusVisuals="True">

                <Border
                    Padding="6"
                    Background="{x:Bind BackgroundBrush, Mode=OneWay}"
                    BorderBrush="{x:Bind BorderBrush, Mode=OneWay}"
                    BorderThickness="2"
                    CornerRadius="4">

                    <StackPanel
                        HorizontalAlignment="{x:Bind Alignment, Mode=OneWay}"
                        VerticalAlignment="Center"
                        Orientation="{x:Bind Orientation, Mode=OneWay}"
                        Spacing="4">

                        <FontIcon
                            HorizontalAlignment="{x:Bind Alignment, Mode=OneWay}"
                            VerticalAlignment="Center"
                            FontFamily="{x:Bind Icon.Font}"
                            FontSize="{x:Bind IconSize, Mode=OneWay}"
                            Glyph="{x:Bind Icon.Glyph}" />

                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{x:Bind Name}"
                            TextAlignment="{x:Bind TextAlignment, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                </Border>
            </ContentControl>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ContentControl
            x:Name="FocusSink"
            Width="1"
            Height="1"
            IsTabStop="True"
            Opacity="0" />

        <ScrollViewer
            Margin="8"
            Background="Transparent"
            HorizontalScrollBarVisibility="Disabled"
            PointerPressed="Root_PointerPressed"
            VerticalScrollBarVisibility="Auto">
            <ItemsRepeater
                x:Name="ContentRepeater"
                ItemTemplate="{StaticResource ItemTemplate}"
                ItemsSource="{x:Bind ItemsSource, Mode=OneWay}"
                TabFocusNavigation="Local"
                XYFocusKeyboardNavigation="Enabled" />
        </ScrollViewer>
    </Grid>
</UserControl>