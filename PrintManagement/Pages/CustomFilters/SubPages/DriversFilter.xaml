<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PrintManagement.Pages.CustomFilters.SubPages.DriversFilter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:comp="using:PrintManagement.Pages.CustomFilters.Comparers"
    xmlns:ctlBdg="using:PrintManagement.Controls.BadgeControl"
    xmlns:ctlTb="using:PrintManagement.Controls.DataTableControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hlps="using:PrintManagement.Pages.CustomFilters.Helpers"
    xmlns:local="using:PrintManagement.Pages.CustomFilters.SubPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mdl="using:PrintManagement.Models"
    xmlns:res="using:PrintManagement.Resources"
    d:DataContext="{d:DesignInstance Type=mdl:PrinterModel}"
    mc:Ignorable="d">

    <Page.Resources>
        <ctlBdg:BadgeRuleCollection x:Key="PackagedBadgeRules">
            <ctlBdg:BadgeRule
                Key="True"
                BackgroundResourceKey="StatusGreenBrush"
                DisplayText="Packaged"
                ForegroundResourceKey="SystemFillColorSuccessBrush"
                Glyph="{x:Bind res:Icons.AcceptMedium.Glyph}"
                GlyphFontFamily="{x:Bind res:Icons.AcceptMedium.Font}" />

            <ctlBdg:BadgeRule
                Key="False"
                BackgroundResourceKey="StatusDefaultBrush"
                DisplayText="Not Packaged"
                ForegroundResourceKey="SystemFillColorSolidNeutralBrush"
                Glyph="{x:Bind res:Icons.ErrorBadge12.Glyph}"
                GlyphFontFamily="{x:Bind res:Icons.ErrorBadge12.Font}" />
        </ctlBdg:BadgeRuleCollection>

        <ctlBdg:BadgeRuleCollection x:Key="XPSDriverBadgeRules">
            <ctlBdg:BadgeRule
                Key="True"
                BackgroundResourceKey="StatusGreenBrush"
                DisplayText="Supported"
                ForegroundResourceKey="SystemFillColorSuccessBrush"
                Glyph="{x:Bind res:Icons.AcceptMedium.Glyph}"
                GlyphFontFamily="{x:Bind res:Icons.AcceptMedium.Font}" />

            <ctlBdg:BadgeRule
                Key="False"
                BackgroundResourceKey="StatusDefaultBrush"
                DisplayText="Not Supported"
                ForegroundResourceKey="SystemFillColorSolidNeutralBrush"
                Glyph="{x:Bind res:Icons.ErrorBadge12.Glyph}"
                GlyphFontFamily="{x:Bind res:Icons.ErrorBadge12.Font}" />
        </ctlBdg:BadgeRuleCollection>

        <ctlBdg:BadgeRuleCollection x:Key="ShareableBadgeRules">
            <ctlBdg:BadgeRule
                Key="True"
                BackgroundResourceKey="StatusGreenBrush"
                DisplayText="Shared"
                ForegroundResourceKey="SystemFillColorSuccessBrush"
                Glyph="{x:Bind res:Icons.AcceptMedium.Glyph}"
                GlyphFontFamily="{x:Bind res:Icons.AcceptMedium.Font}" />

            <ctlBdg:BadgeRule
                Key="False"
                BackgroundResourceKey="StatusDefaultBrush"
                DisplayText="Not Shared"
                ForegroundResourceKey="SystemFillColorSolidNeutralBrush"
                Glyph="{x:Bind res:Icons.ErrorBadge12.Glyph}"
                GlyphFontFamily="{x:Bind res:Icons.ErrorBadge12.Font}" />
        </ctlBdg:BadgeRuleCollection>

        <ctlBdg:BadgeRuleCollection x:Key="DriverIsolationBadgeRules">
            <!--  Green  -->
            <ctlBdg:BadgeRule
                Key="{x:Bind hlps:IsolationFlag.Shared}"
                BackgroundResourceKey="StatusGreenBrush"
                DisplayText="Shared"
                ForegroundResourceKey="SystemFillColorSuccessBrush"
                Glyph="{x:Bind res:Icons.InternetSharing.Glyph}"
                GlyphFontFamily="{x:Bind res:Icons.InternetSharing.Font}" />

            <!--  Orange  -->
            <ctlBdg:BadgeRule
                Key="{x:Bind hlps:IsolationFlag.Isolation}"
                BackgroundResourceKey="StatusOrangeBrush"
                DisplayText="Isolated"
                ForegroundResourceKey="SystemFillColorCautionBrush"
                Glyph="{x:Bind res:Icons.Lock.Glyph}"
                GlyphFontFamily="{x:Bind res:Icons.Lock.Font}" />

            <!--  Red  -->
            <ctlBdg:BadgeRule
                Key="{x:Bind hlps:IsolationFlag.Unknown}"
                BackgroundResourceKey="StatusRedBrush"
                DisplayText="Unknown"
                ForegroundResourceKey="SystemFillColorCriticalBrush"
                Glyph="{x:Bind res:Icons.Help.Glyph}"
                GlyphFontFamily="{x:Bind res:Icons.Help.Font}" />

            <!--  Grey  -->
            <ctlBdg:BadgeRule
                Key="{x:Bind hlps:IsolationFlag.None}"
                BackgroundResourceKey="StatusDefaultBrush"
                DisplayText="None"
                ForegroundResourceKey="SystemFillColorSolidNeutralBrush"
                Glyph="{x:Bind res:Icons.ErrorBadge12.Glyph}"
                GlyphFontFamily="{x:Bind res:Icons.ErrorBadge12.Font}" />
        </ctlBdg:BadgeRuleCollection>
    </Page.Resources>

    <ctlTb:DataTable
        x:Name="PrintersTable"
        Grid.Column="2"
        CompactView="{x:Bind IsCompact, Mode=OneWay}"
        ItemsSource="{x:Bind DriverModelList, Mode=OneWay}">

        <ctlTb:TableColumn
            Width="Auto"
            Header="Driver Name"
            IsPrimary="True"
            Path="DriverName">
            <ctlTb:TableColumn.CellTemplate>
                <DataTemplate x:DataType="mdl:DriverModel">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            FontFamily="{x:Bind res:Icons.Driver.Font}"
                            FontSize="16"
                            Glyph="{x:Bind res:Icons.Driver.Glyph}" />

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{x:Bind DriverName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ctlTb:TableColumn.CellTemplate>
        </ctlTb:TableColumn>



        <ctlTb:TableColumn
            Width="152"
            Header="Environment"
            Path="Environment" />

        <ctlTb:TableColumn
            Width="151"
            Header="Driver Version"
            Path="DriverVersion" />

        <ctlTb:TableColumn
            Width="130"
            Header="Driver Isolation"
            Path="DriverIsolation">
            <ctlTb:TableColumn.CellTemplate>
                <DataTemplate x:DataType="mdl:DriverModel">
                    <ctlBdg:Badge Rules="{StaticResource DriverIsolationBadgeRules}" Value="{x:Bind DriverIsolation, Mode=OneWay}" />
                </DataTemplate>
            </ctlTb:TableColumn.CellTemplate>
        </ctlTb:TableColumn>

        <ctlTb:TableColumn
            Width="112"
            Header="Provider"
            Path="Provider" />

        <ctlTb:TableColumn
            Width="221"
            Header="Server Name"
            Path="ServerName" />

        <ctlTb:TableColumn
            Width="129"
            Header="Print Processor"
            Path="PrintProcessor" />

        <ctlTb:TableColumn
            Width="Auto"
            Header="Packaged"
            Path="Packaged">
            <ctlTb:TableColumn.CellTemplate>
                <DataTemplate x:DataType="mdl:DriverModel">
                    <ctlBdg:Badge Rules="{StaticResource PackagedBadgeRules}" Value="{x:Bind Packaged, Mode=OneWay}" />
                </DataTemplate>
            </ctlTb:TableColumn.CellTemplate>
        </ctlTb:TableColumn>

        <ctlTb:TableColumn
            Width="Auto"
            Header="Driver Date"
            Path="DriverDate">
            <ctlTb:TableColumn.CellTemplate>
                <DataTemplate x:DataType="mdl:DriverModel">
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind DriverDate, Converter={StaticResource DateConverter}}" />
                </DataTemplate>
            </ctlTb:TableColumn.CellTemplate>
        </ctlTb:TableColumn>

        <ctlTb:TableColumn
            Width="Auto"
            Header="Inf Path"
            MaxAutoWidth="800"
            Path="InfPath" />

        <ctlTb:TableColumn
            Width="Auto"
            Header="XPS Driver"
            Path="XPSDriver">
            <ctlTb:TableColumn.CellTemplate>
                <DataTemplate x:DataType="mdl:DriverModel">
                    <ctlBdg:Badge Rules="{StaticResource XPSDriverBadgeRules}" Value="{x:Bind XPSDriver, Mode=OneWay}" />
                </DataTemplate>
            </ctlTb:TableColumn.CellTemplate>
        </ctlTb:TableColumn>

        <ctlTb:TableColumn
            Width="Auto"
            Header="Config File Path"
            MaxAutoWidth="870"
            Path="ConfigFilePath" />

        <ctlTb:TableColumn
            Width="Auto"
            Header="Data File Path"
            MaxAutoWidth="800"
            Path="DataFilePath" />

        <ctlTb:TableColumn
            Width="141"
            Header="Default Datatype"
            Path="DefaultDatatype" />

        <ctlTb:TableColumn
            Width="Auto"
            Header="Driver File Path"
            MaxAutoWidth="870"
            Path="DriverFilePath" />

        <ctlTb:TableColumn
            Width="Auto"
            Header="Hardware ID"
            MaxAutoWidth="400"
            Path="HardwareID" />

        <ctlTb:TableColumn
            Width="Auto"
            Header="Help File Path"
            MaxAutoWidth="400"
            Path="HelpFilePath" />

        <ctlTb:TableColumn
            Width="151"
            Header="Language Monitor"
            Path="LanguageMonitor" />

        <ctlTb:TableColumn
            Width="119"
            Header="Manufacturer"
            Path="Manufacturer" />

        <ctlTb:TableColumn
            Width="112"
            Header="OEM URL"
            Path="OEMURL" />

        <ctlTb:TableColumn
            Width="Auto"
            Header="Shareable"
            Path="Shareable">
            <ctlTb:TableColumn.CellTemplate>
                <DataTemplate x:DataType="mdl:DriverModel">
                    <ctlBdg:Badge Rules="{StaticResource ShareableBadgeRules}" Value="{x:Bind Shareable, Mode=OneWay}" />
                </DataTemplate>
            </ctlTb:TableColumn.CellTemplate>
        </ctlTb:TableColumn>

        <ctlTb:TableColumn
            Width="173"
            Header="Type"
            Path="Type" />

    </ctlTb:DataTable>
</Page>
