<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PrintManagement.Pages.CustomFilters.SubPages.DriversFilter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:comp="using:PrintManagement.Pages.CustomFilters.Comparers"
    xmlns:ctl="using:PrintManagement.Controls"
    xmlns:ctlTb="using:PrintManagement.Controls.Table"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PrintManagement.Pages.CustomFilters.SubPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="using:PrintManagement.Resources"
    xmlns:vm="using:PrintManagement.Pages.CustomFilters.Filters"
    d:DataContext="{d:DesignInstance Type=vm:PrinterFilterModel}"
    mc:Ignorable="d">

    <ctlTb:DataTable
        x:Name="PrintersTable"
        Grid.Column="2"
        CompactView="{x:Bind IsCompact, Mode=OneWay}"
        ItemsSource="{x:Bind DriverFiltersList, Mode=OneWay}">

        <ctlTb:TableColumn
            Width="Auto"
            Header="Driver Name"
            IsPrimary="True"
            Path="DriverName">
            <ctlTb:TableColumn.CellTemplate>
                <DataTemplate x:DataType="vm:DriversFilterModel">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            FontFamily="{x:Bind res:Icons.Driver.Font}"
                            FontSize="16"
                            Glyph="{x:Bind res:Icons.Driver.Glyph}" />

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{x:Bind DriverName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ctlTb:TableColumn.CellTemplate>
        </ctlTb:TableColumn>



        <ctlTb:TableColumn
            Width="152"
            Header="Environment"
            Path="Environment" />

        <ctlTb:TableColumn
            Width="151"
            Header="Driver Version"
            Path="DriverVersion" />

        <ctlTb:TableColumn
            Width="130"
            Header="Driver Isolation"
            Path="DriverIsolation" />

        <ctlTb:TableColumn
            Width="112"
            Header="Provider"
            Path="Provider" />

        <ctlTb:TableColumn
            Width="221"
            Header="Server Name"
            Path="ServerName" />

        <ctlTb:TableColumn
            Width="129"
            Header="Print Processor"
            Path="PrintProcessor" />

        <ctlTb:TableColumn
            Width="Auto"
            Header="Packaged"
            Path="Packaged">
            <ctlTb:TableColumn.CellTemplate>
                <DataTemplate x:DataType="vm:DriversFilterModel">
                    <ctl:BoolBadge
                        FalseText="Not Packaged"
                        TrueText="Packaged"
                        Value="{x:Bind Packaged, Mode=OneWay}" />
                </DataTemplate>
            </ctlTb:TableColumn.CellTemplate>
        </ctlTb:TableColumn>

        <ctlTb:TableColumn
            Width="Auto"
            Header="Driver Date"
            Path="DriverDate">
            <ctlTb:TableColumn.CellTemplate>
                <DataTemplate x:DataType="vm:DriversFilterModel">
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind DriverDate, Converter={StaticResource DateConverter}}" />
                </DataTemplate>
            </ctlTb:TableColumn.CellTemplate>
        </ctlTb:TableColumn>

        <ctlTb:TableColumn
            Width="Auto"
            Header="Inf Path"
            MaxAutoWidth="800"
            Path="InfPath" />

        <ctlTb:TableColumn
            Width="Auto"
            Header="XPS Driver"
            Path="XPSDriver">
            <ctlTb:TableColumn.CellTemplate>
                <DataTemplate x:DataType="vm:DriversFilterModel">
                    <ctl:BoolBadge
                        FalseText="Not Supported"
                        TrueText="Supported"
                        Value="{x:Bind XPSDriver, Mode=OneWay}" />
                </DataTemplate>
            </ctlTb:TableColumn.CellTemplate>
        </ctlTb:TableColumn>

        <ctlTb:TableColumn
            Width="Auto"
            Header="Config File Path"
            MaxAutoWidth="870"
            Path="ConfigFilePath" />

        <ctlTb:TableColumn
            Width="Auto"
            Header="Data File Path"
            MaxAutoWidth="800"
            Path="DataFilePath" />

        <ctlTb:TableColumn
            Width="141"
            Header="Default Datatype"
            Path="DefaultDatatype" />

        <ctlTb:TableColumn
            Width="Auto"
            Header="Driver File Path"
            MaxAutoWidth="870"
            Path="DriverFilePath" />

        <ctlTb:TableColumn
            Width="Auto"
            Header="Hardware ID"
            MaxAutoWidth="400"
            Path="HardwareID" />

        <ctlTb:TableColumn
            Width="121"
            Header="Help File Path"
            Path="HelpFilePath" />

        <ctlTb:TableColumn
            Width="151"
            Header="Language Monitor"
            Path="LanguageMonitor" />

        <ctlTb:TableColumn
            Width="119"
            Header="Manufacturer"
            Path="Manufacturer" />

        <ctlTb:TableColumn
            Width="112"
            Header="OEM URL"
            Path="OEMURL" />

        <ctlTb:TableColumn
            Width="Auto"
            Header="Shareable"
            Path="Shareable">
            <ctlTb:TableColumn.CellTemplate>
                <DataTemplate x:DataType="vm:DriversFilterModel">
                    <ctl:BoolBadge
                        FalseText="Not Shared"
                        TrueText="Shared"
                        Value="{x:Bind Shareable, Mode=OneWay}" />
                </DataTemplate>
            </ctlTb:TableColumn.CellTemplate>
        </ctlTb:TableColumn>

        <ctlTb:TableColumn
            Width="173"
            Header="Type"
            Path="Type" />

    </ctlTb:DataTable>
</Page>
