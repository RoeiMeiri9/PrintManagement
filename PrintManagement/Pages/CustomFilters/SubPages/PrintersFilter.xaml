<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PrintManagement.Pages.CustomFilters.SubPages.PrintersFilter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:comp="using:PrintManagement.Pages.CustomFilters.Comparers"
    xmlns:ctl="using:PrintManagement.Controls"
    xmlns:ctlTb="using:PrintManagement.Controls.Table"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hlps="using:PrintManagement.Pages.CustomFilters.Helpers"
    xmlns:local="using:PrintManagement.Pages.CustomFilters.SubPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="using:PrintManagement.Resources"
    xmlns:vm="using:PrintManagement.Pages.CustomFilters.Filters"
    d:DataContext="{d:DesignInstance Type=vm:PrinterFilterModel}"
    mc:Ignorable="d">

    <Page.Resources>
        <comp:PrinterStatusListComparer x:Key="StatusComparer" />
    </Page.Resources>

    <ctlTb:DataTable
        x:Name="PrintersTable"
        Grid.Column="2"
        ItemsSource="{x:Bind PrinterFiltersList, Mode=OneWay}">

        <ctlTb:TableColumn
            Width="Auto"
            Header="Printer Name"
            SortPath="Name">
            <ctlTb:TableColumn.CellTemplate>
                <DataTemplate x:DataType="vm:PrinterFilterModel">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            FontSize="16"
                            Glyph="{x:Bind res:Icons.Printer.Glyph}" />

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{x:Bind Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ctlTb:TableColumn.CellTemplate>
        </ctlTb:TableColumn>

        <ctlTb:TableColumn
            Width="Auto"
            Comparer="{StaticResource StatusComparer}"
            Header="Queue Status"
            SortPath="QueueStatus">
            <ctlTb:TableColumn.CellTemplate>
                <DataTemplate x:DataType="vm:PrinterFilterModel">
                    <ItemsControl ItemsSource="{x:Bind QueueStatus, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="hlps:PrinterStatusInfo">
                                <Border
                                    Margin="-4,0,0,0"
                                    Padding="8,3"
                                    HorizontalAlignment="Left"
                                    Background="{x:Bind Flags, Converter={StaticResource StatusToBrushConverter}, ConverterParameter=Background}"
                                    CornerRadius="12">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{x:Bind Flags, Converter={StaticResource StatusToBrushConverter}, ConverterParameter=Foreground}"
                                        Text="{x:Bind Status}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DataTemplate>
            </ctlTb:TableColumn.CellTemplate>
        </ctlTb:TableColumn>

        <ctlTb:TableColumn
            Width="124"
            Header="Jobs In Queue"
            Path="JobsInQueue">
            <ctlTb:TableColumn.CellTemplate>
                <DataTemplate x:DataType="vm:PrinterFilterModel">
                    <TextBlock Foreground="{x:Bind JobsInQueue, Converter={StaticResource JobsCounterConverter}}" Text="{x:Bind JobsInQueue, Mode=OneWay}" />
                </DataTemplate>
            </ctlTb:TableColumn.CellTemplate>
        </ctlTb:TableColumn>

        <ctlTb:TableColumn
            Width="Auto"
            Header="Port Name"
            MaxAutoWidth="450"
            Path="PortName" />

        <ctlTb:TableColumn
            Width="221"
            Header="Server Name"
            Path="ServerName" />

        <ctlTb:TableColumn
            Width="Auto"
            Header="Connection Summary"
            Path="ConnectionSummary" />

        <ctlTb:TableColumn
            Width="Auto"
            Header="Driver Name"
            MaxAutoWidth="450"
            Path="DriverName" />

        <ctlTb:TableColumn
            Width="142"
            Header="Driver Version"
            Path="DriverVersion" />

        <ctlTb:TableColumn
            Width="173"
            Header="Driver Type"
            Path="DriverType" />


        <ctlTb:TableColumn
            Width="Auto"
            Header="Branch Office"
            Path="BranchOffice">
            <ctlTb:TableColumn.CellTemplate>
                <DataTemplate x:DataType="vm:PrinterFilterModel">
                    <ctl:BoolBadge
                        FalseText="No"
                        TrueText="Yes"
                        Value="{x:Bind BranchOffice, Mode=OneWay}" />
                </DataTemplate>
            </ctlTb:TableColumn.CellTemplate>
        </ctlTb:TableColumn>

        <ctlTb:TableColumn
            Width="112"
            Header="Comments"
            Path="Comments" />

        <ctlTb:TableColumn
            Width="Auto"
            Header="Is Shared"
            Path="IsShared">
            <ctlTb:TableColumn.CellTemplate>
                <DataTemplate x:DataType="vm:PrinterFilterModel">
                    <ctl:BoolBadge
                        FalseText="Not Shared"
                        TrueText="Shared"
                        Value="{x:Bind IsShared, Mode=OneWay}" />
                </DataTemplate>
            </ctlTb:TableColumn.CellTemplate>
        </ctlTb:TableColumn>

        <ctlTb:TableColumn
            Width="Auto"
            Header="Location"
            MaxAutoWidth="450"
            Path="Location" />

        <ctlTb:TableColumn
            Width="112"
            Header="Provider"
            Path="Provider" />

        <ctlTb:TableColumn
            Width="Auto"
            Header="Share Name"
            Path="ShareName">
            <ctlTb:TableColumn.CellTemplate>
                <DataTemplate x:DataType="vm:PrinterFilterModel">
                    <Grid
                        Height="28"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontStyle="Italic"
                            Foreground="{ThemeResource TemporaryTextFillColorDisabled}"
                            Text="&lt; Not Shared &gt;"
                            Visibility="{x:Bind IsShared, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ShareName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind IsShared, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=hideOnNull}" />
                    </Grid>
                </DataTemplate>
            </ctlTb:TableColumn.CellTemplate>
        </ctlTb:TableColumn>

        <ctlTb:TableColumn
            Width="136"
            Header="Print Processor"
            Path="PrintProcessor" />

        <ctlTb:TableColumn
            Width="136"
            Header="Data Type"
            Path="DataType" />

    </ctlTb:DataTable>
</Page>
