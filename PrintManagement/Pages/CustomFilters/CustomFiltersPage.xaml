<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PrintManagement.Pages.CustomFilters.CustomFiltersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CommunityToolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:PrintManagement.Converters"
    xmlns:ctrlSSC="using:PrintManagement.Controls.SnapSplitterControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:filters="using:PrintManagement.Pages.CustomFilters.Filters"
    xmlns:local="using:PrintManagement.Pages.CustomFilters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prim="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:res="using:PrintManagement.Resources"
    xmlns:tvf="using:PrintManagement.Pages.CustomFilters.Components.TreeViewLeaf"
    x:Name="PageRoot"
    d:DataContext="{d:DesignInstance Type=filters:FilterModler}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="SplitRoot">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    x:Name="TreeColumn"
                    Width="250"
                    MaxWidth="500" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                CornerRadius="0">
                <TreeView
                    x:Name="FiltersTree"
                    Margin="4,7,-3,8"
                    ItemsSource="{x:Bind FiltersList, Mode=OneWay}"
                    SelectionChanged="FiltersTree_SelectionChanged">
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="tvf:FilterLeaf">
                            <TreeViewItem IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}" ItemsSource="{x:Bind Children}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!--  Note! FontFamily MUST stay with the old Binding and NOT be using the newer x:Bind  -->
                                        <FontIcon
                                            Grid.Column="0"
                                            FontFamily="{Binding LeafIcon.Font, Mode=OneWay}"
                                            FontSize="16"
                                            Glyph="{x:Bind LeafIcon.Glyph, Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind DisplayName, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind TotalItems, Mode=OneWay}"
                                        Visibility="{x:Bind DisplayTotalItems, Mode=OneWay}" />
                                </Grid>
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>
            <ctrlSSC:SnapSplitter
                x:Name="TreeSplitter"
                Grid.Column="1"
                Width="8"
                VerticalAlignment="Stretch"
                Background="Transparent"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                PointerCaptureLost="TreeSplitter_PointerCaptureLost"
                PointerEntered="TreeSplitter_PointerEntered"
                PointerExited="TreeSplitter_PointerExited"
                PointerMoved="TreeSplitter_PointerMoved"
                PointerPressed="TreeSplitter_PointerPressed"
                PointerReleased="TreeSplitter_PointerReleased">
                <Border
                    x:Name="SplitterHighlight"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                    CornerRadius="1"
                    IsHitTestVisible="False"
                    Opacity="0">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.15" />
                    </Border.OpacityTransition>
                </Border>
            </ctrlSSC:SnapSplitter>

            <Frame
                x:Name="FilterSubPage"
                Grid.Row="1"
                Grid.Column="2" />
        </Grid>
    </Grid>
</Page>
