<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PrintManagement.Pages.CommonPageWrapper.CommonPageWrapper"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PrintManagement.Pages.CommonPageWrapper"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="using:PrintManagement.Resources"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="Controls" Height="auto" />
            <RowDefinition x:Name="Frame" Height="*" />
        </Grid.RowDefinitions>
        <Grid
            Grid.Row="0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Padding="8"
                Orientation="Horizontal"
                Spacing="4">
                <DropDownButton
                    x:Name="ViewDropDownButton"
                    Height="36"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Loaded="ViewDropDownButton_Loaded">
                    <DropDownButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ContentPresenter x:Name="SelectedIconPresenter" VerticalAlignment="Center" />
                            <TextBlock
                                Margin="0,-1,8,1"
                                VerticalAlignment="Center"
                                Text="View" />
                        </StackPanel>
                    </DropDownButton.Content>

                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Add/Remove Columns...">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{x:Bind res:Icons.Add.Font}" Glyph="{x:Bind res:Icons.Add.Glyph}" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>

                            <MenuFlyoutSeparator />

                            <RadioMenuFlyoutItem
                                Click="ViewMode_Click"
                                GroupName="ViewMode"
                                Text="Large Icons">
                                <RadioMenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{x:Bind res:Icons.AppTitle.Font}" Glyph="{x:Bind res:Icons.AppTitle.Glyph}" />
                                </RadioMenuFlyoutItem.Icon>
                            </RadioMenuFlyoutItem>

                            <RadioMenuFlyoutItem
                                Click="ViewMode_Click"
                                GroupName="ViewMode"
                                Text="Small Icons">
                                <RadioMenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{x:Bind res:Icons.ViewAll.Font}" Glyph="{x:Bind res:Icons.ViewAll.Glyph}" />
                                </RadioMenuFlyoutItem.Icon>
                            </RadioMenuFlyoutItem>

                            <RadioMenuFlyoutItem
                                Click="ViewMode_Click"
                                GroupName="ViewMode"
                                Text="List">
                                <RadioMenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{x:Bind res:Icons.AllApps.Font}" Glyph="{x:Bind res:Icons.AllApps.Glyph}" />
                                </RadioMenuFlyoutItem.Icon>
                            </RadioMenuFlyoutItem>

                            <RadioMenuFlyoutItem
                                x:Name="DefaultDetailsViewItem"
                                Click="ViewMode_Click"
                                GroupName="ViewMode"
                                IsChecked="True"
                                Text="Details">
                                <RadioMenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{x:Bind res:Icons.ListDetail.Font}" Glyph="{x:Bind res:Icons.ListDetail.Glyph}" />
                                </RadioMenuFlyoutItem.Icon>
                            </RadioMenuFlyoutItem>

                            <MenuFlyoutSeparator />

                            <MenuFlyoutSubItem Text="Customize...">
                                <ToggleMenuFlyoutItem
                                    x:Name="CompactViewToggleItem"
                                    Click="ToggleMenuFlyoutItem_Click"
                                    Text="Compact View">
                                    <ToggleMenuFlyoutItem.Icon>
                                        <PathIcon Data="M5.592439339701741,1.771677202284991c-.165685564901651,0-.300000011920929.134314447017459-.300000011920929.300000011920929s.134314447019278.300000011920929.300000011920929.300000011920929h3.70348614872637c.165685278800083,0,.300000011920929-.134314447017459.300000011920929-.300000011920929s-.134314733120846-.300000011920929-.300000011920929-.300000011920929h-3.70348614872637ZM5.592439339701741,3.571677273810565c-.165685564901651,0-.300000011920929.134314733120846-.300000011920929.300000011920929s.134314447019278.300000011920929.300000011920929.300000011920929h3.70348614872637c.165685278800083,0,.300000011920929-.134314733120846.300000011920929-.300000011920929s-.134314733120846-.300000011920929-.300000011920929-.300000011920929h-3.70348614872637ZM5.292439327780812,5.671677357257067c0-.16799984645877.131999879360592-.300000011920929.300000011920929-.300000011920929h3.70348614872637c.165685278800083,0,.300000011920929.134314733120846.300000011920929.300000011920929s-.134314733120846.300000011920929-.300000011920929.300000011920929h-3.70348614872637c-.165685564901651,0-.300000011920929-.134314733120846-.300000011920929-.300000011920929ZM5.592439339701741,7.171677416861712c-.165685564901651,0-.300000011920929.134314733120846-.300000011920929.300000011920929s.134314447019278.300000011920929.300000011920929.300000011920929h3.70348614872637c.165685278800083,0,.300000011920929-.134314733120846.300000011920929-.300000011920929s-.134314733120846-.300000011920929-.300000011920929-.300000011920929h-3.70348614872637ZM2.369999264477883,9.243354631067632c0,.165685278800083-.134314733120846.300000011920929-.300000011920929.300000011920929s-.300000011920929-.134314733120846-.300000011920929-.300000011920929v-2.851677538454169l-1.289999822378377,1.290000251530728c-.132548337482149.099411110059009-.320589078290141.072547820112959-.419999902249401-.060000803470757-.079999354678876-.106666378444061-.079999354678876-.253332720332764