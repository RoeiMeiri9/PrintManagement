                                    </ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                            </MenuFlyoutSubItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button
                    Height="36"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="{x:Bind res:Icons.Delete.Font}" Glyph="{x:Bind res:Icons.Delete.Glyph}" />
                        <TextBlock
                            Margin="0,-1,8,1"
                            VerticalAlignment="Center"
                            Text="Remove" />
                    </StackPanel>
                </Button>
                <Button
                    Height="36"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Click="ExportButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="{x:Bind res:Icons.Share.Font}" Glyph="{x:Bind res:Icons.Share.Glyph}" />
                        <TextBlock
                            Margin="0,-1,8,1"
                            VerticalAlignment="Center"
                            Text="Export" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Padding="8"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    Height="36"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0">
                    <FontIcon
                        FontFamily="{x:Bind res:Icons.Refresh.Font}"
                        FontSize="14"
                        Glyph="{x:Bind res:Icons.Refresh.Glyph}" />
                </Button>
                <Button
                    Height="36"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0">
                    <FontIcon
                        FontFamily="{x:Bind res:Icons.Up.Font}"
                        FontSize="14"
                        Glyph="{x:Bind res:Icons.Up.Glyph}" />
                </Button>
                <Button
                    Height="36"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0">
                    <FontIcon
                        FontFamily="{x:Bind res:Icons.Back.Font}"
                        FontSize="14"
                        Glyph="{x:Bind res:Icons.Back.Glyph}" />
                </Button>
                <Button
                    Height="36"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0">
                    <FontIcon
                        FontFamily="{x:Bind res:Icons.Forward.Font}"
                        FontSize="14"
                        Glyph="{x:Bind res:Icons.Forward.Glyph}" />
                </Button>
            </StackPanel>
        </Grid>
        <Frame x:Name="navFrame" Grid.Row="1" />
    </Grid>
</Page>
