<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PrintManagement.Pages.CustomFilterPage.SubPages.PrintersFilter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:PrintManagement.Controls.Table"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PrintManagement.Pages.CustomFilterPage.SubPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="using:PrintManagement.Resources"
    xmlns:vm="using:PrintManagement.Pages.CustomFilterPage.Filters"
    d:DataContext="{d:DesignInstance Type=vm:PrinterFilterModel}"
    mc:Ignorable="d">

    <ctl:DataTable
        x:Name="PrintersTable"
        Grid.Column="2"
        ItemsSource="{x:Bind PrinterFiltersList}">

        <ctl:TableColumn
            Width="237"
            Header="Printer Name"
            SortDirection="Ascending"
            SortPath="PrinterName">
            <ctl:TableColumn.CellTemplate>
                <DataTemplate x:DataType="vm:PrinterFilterModel">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            FontSize="16"
                            Glyph="{x:Bind res:Icons.Printer.Glyph}" />

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{x:Bind PrinterName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ctl:TableColumn.CellTemplate>
        </ctl:TableColumn>

        <ctl:TableColumn
            Width="118"
            Header="Queue Status"
            SortPath="QueueStatus">
            <ctl:TableColumn.CellTemplate>
                <DataTemplate x:DataType="vm:PrinterFilterModel">
                    <Border
                        Margin="-4,0,0,0"
                        Padding="8,3"
                        HorizontalAlignment="Left"
                        Background="{x:Bind QueueStatus, Mode=OneWay, Converter={StaticResource StatusToBrushConverter}, ConverterParameter=Background}"
                        CornerRadius="12">
                        <TextBlock
                            FontSize="12"
                            Foreground="{x:Bind QueueStatus, Mode=OneWay, Converter={StaticResource StatusToBrushConverter}, ConverterParameter=Foreground}"
                            Text="{x:Bind QueueStatus, Mode=OneWay}" />
                    </Border>
                </DataTemplate>
            </ctl:TableColumn.CellTemplate>
        </ctl:TableColumn>

        <ctl:TableColumn
            Width="124"
            Header="Jobs In Queue"
            Path="JobsInQueue" />

        <ctl:TableColumn
            Width="221"
            Header="Server Name"
            Path="ServerName" />

        <ctl:TableColumn
            Width="227"
            Header="Driver Name"
            Path="DriverName" />

        <ctl:TableColumn
            Width="142"
            Header="Driver Version"
            Path="DriverVersion" />

        <ctl:TableColumn
            Width="173"
            Header="Driver Type"
            Path="DriverType" />


        <ctl:TableColumn
            Width="119"
            Header="Branch Office"
            Path="BranchOffice" />

        <ctl:TableColumn
            Width="112"
            Header="Comments"
            Path="Comments" />

        <ctl:TableColumn
            Width="112"
            Header="Is Shared"
            Path="IsShared" />

        <ctl:TableColumn
            Width="112"
            Header="Location"
            Path="Location" />

        <ctl:TableColumn
            Width="112"
            Header="Provider"
            Path="Provider" />

        <ctl:TableColumn
            Width="136"
            Header="Share Name"
            Path="ShareName" />

    </ctl:DataTable>
</Page>
